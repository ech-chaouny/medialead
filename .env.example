# Emails des leads (Resend) : clé API, destinataires (séparés par des virgules) et expéditeur.
# Le domaine medialead.ma doit être vérifié dans Resend. Avec ou sans les webhooks ci-dessous.
RESEND_API_KEY=re_xxxxxxxx
LEADS_TO=contact@medialead.ma
LEADS_FROM=Medialead <contact@medialead.ma>

# Webhook (Make, Zapier, HubSpot…) qui reçoit les leads du simulateur Growth Audit.
# Sans cette variable, le formulaire répond « envoi indisponible » et ne confirme rien.
GROWTH_AUDIT_WEBHOOK_URL=

# Webhook qui reçoit les demandes de la page /contact (formulaire de qualification).
CONTACT_WEBHOOK_URL=

# Mesure et publicité : chargées seulement après consentement (bannière cookies). Laisser vide pour désactiver.
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=000000000000000
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-000000000
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=xxxxxxxxxxxxxxxxxxxx
